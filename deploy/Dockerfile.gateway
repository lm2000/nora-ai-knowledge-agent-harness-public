FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LITELLM_TELEMETRY=false
WORKDIR /app
COPY deploy/gateway.lock /app/gateway.lock
RUN pip install --no-cache-dir -c gateway.lock 'litellm[proxy]==1.103.2'
COPY deploy/gateway.py deploy/gateway.yaml /app/
ENTRYPOINT ["python", "/app/gateway.py"]
