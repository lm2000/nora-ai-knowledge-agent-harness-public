# Copy to .env and set the host user's numeric IDs (id -u / id -g).
NORA_UID=1000
NORA_GID=1000
NORA_COLLECTION=nora_prepared_bge_v1
NORA_OLLAMA_URL=https://ollama.com
NORA_OLLAMA_MODEL=gpt-oss:20b
NORA_DAILY_LIMIT=60
NORA_REQUEST_TIMEOUT=180
NORA_UI_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
NORA_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,retrieval:*
NORA_BGE_URL=http://bge:8002

# Role runtimes. Each container sets NORA_ROLE internally; the UI routes by role.
# Override per-role model inventory with JSON arrays, e.g.:
# NORA_KNOWLEDGE_MODELS=[{"provider":"ollama","model":"gpt-oss:20b","base_url":"https://ollama.com"}]
# NORA_RESEARCH_MODELS=[...]
# NORA_INTERVIEW_MODELS=[...]

# Provider credentials belong in .runtime/secrets/{ollama,fireworks}, not here.
# The BGE service credential is generated by `nora init` in .runtime/secrets/bge.

# For the optional local profile, set NORA_OLLAMA_URL=http://ollama:11434.

# For GCS prepared-document storage, set the authoritative pointer URL:
# NORA_GCS_POINTER=gs://your-bucket/releases/current.json
# NORA_GCS_PROJECT=your-gcp-project

# Optional selector weights (assumptions, not measured values):
# NORA_SELECTOR_COST_WEIGHT=1.0
# NORA_SELECTOR_LATENCY_WEIGHT=1.0
# NORA_SELECTOR_LOG=.runtime/state/selector.log
