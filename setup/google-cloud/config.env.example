# Google Cloud configuration for offline plan rendering.
# ----------------------------------------------------------
# Do NOT commit real secrets. Fill in values before running scripts.

# Explicit target project ID; example-project is allowed if deliberately selected.
PROJECT_ID=

# Region where resources will be created, e.g. us-central1 or europe-west1
REGION=

# Zone within the region, e.g. us-central1-a (must start with REGION-)
ZONE=

# Accepted vector database.
VECTOR_DB=qdrant

# Compute Engine machine type for the VM (e.g., e2-standard-4). No validation against real types.
MACHINE_TYPE=

# Size of the dedicated persistent data disk in GiB (positive integer).
DISK_SIZE_GB=

# Name of the GCS bucket for backups (lower‑case, hyphens only). Example: my-gcp-project-backup
BACKUP_BUCKET_NAME=

# Placeholder for future secrets – DO NOT store real credentials here.
# API_KEY=

# Fixed stack in rendered plan: Docling, self-hosted BAAI/bge-base-en-v1.5, Qdrant, LangChain.
# These are not additional config keys; existing config.env remains compatible.
